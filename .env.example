# Credentials for the integration suite. Copy to .env and edit:
#
#     cp .env.example .env
#
# .env is git-ignored, and is read by the PHPUnit bootstrap. A variable
# already set in the environment wins over the file, so CI and one-off
# overrides on the command line still work:
#
#     DB_MYSQL_PASS=other ./vendor/bin/phpunit --testsuite integration
#
# A dialect is skipped only while its DSN is empty. Once a DSN is set the
# tests connect for real, and a bad password is an error, not a skip.
# The database must already exist; the tests create and drop their own
# test_* tables inside it. See CONTRIBUTING.md.

DB_MYSQL_DSN='mysql:host=127.0.0.1;port=3306;dbname=aura_sqlquery_test'
DB_MYSQL_USER=root
DB_MYSQL_PASS=root

DB_PGSQL_DSN='pgsql:host=127.0.0.1;port=5432;dbname=aura_sqlquery_test'
DB_PGSQL_USER=postgres
DB_PGSQL_PASS=postgres

# Needs the pdo_sqlsrv extension and Microsoft's ODBC Driver 18, which most
# machines do not have. Left commented out because a DSN that is set makes a
# missing driver an error rather than a skip; uncomment once you have both.
# See CONTRIBUTING.md.
# DB_SQLSRV_DSN='sqlsrv:Server=127.0.0.1,1433;Database=aura_sqlquery_test;TrustServerCertificate=1'
DB_SQLSRV_USER=sa
DB_SQLSRV_PASS='Aura!Passw0rd'
